                        <input type="text" class="editable" id="birth_date" value="{{ $submission['birth_date'] ?? '.../.../......' }}" readonly style="width: 120px;">
                    </td>
                </tr>
                <tr>
                    <td>Jenis Kelamin</td>
                    <td>:</td>
                    <td><input type="text" class="editable" id="gender" value="{{ $submission['gender'] ?? '................' }}" readonly style="width: 150px;"></td>
                </tr>
                <tr>
